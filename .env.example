# Firebase (client-side — auth only)
NEXT_PUBLIC_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_PROJECT_ID=your_project_id
NEXT_PUBLIC_APP_ID=your_app_id

# Core integration:
#   true  = embedded in Core under /business (basePath set at build time)
#   false = standalone at host root (no /business prefix; use for crm-test)
# Must be set correctly in Vault BEFORE `next build` — basePath is baked in.
NEXT_PUBLIC_IS_CORE=false

# Core platform origin (used when NEXT_PUBLIC_IS_CORE=true)
# NEXT_PUBLIC_CORE_ORIGIN=https://core.selamnew.com

# App Environment
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Module visibility (frontend nav). Defaults to true when unset.
# Set to false in staging/production to hide Marketing, Partners, and AI Insights.
NEXT_PUBLIC_MODULE_MARKETING_ENABLED=true
NEXT_PUBLIC_MODULE_REPORTS_ENABLED=true

# CRM API (required — all backend communication goes through this URL)
NEXT_PUBLIC_CRM_URL=http://localhost:3021/api/v1

# Central notification & email service (proxied through CRM backend)
# Frontend should NOT call these directly — CRM backend uses EMAIL_SERVER_URL
NOTIFICATION_URL=your_notification_url
EMAIL_URL=your_notification_url

# Analytics (iframe embed only)
NEXT_PUBLIC_METABASE_URL=https://metabase.ienetworks.co
